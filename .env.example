PORT=3001

# Public base URL of this backend, used to build unsubscribe links embedded in outbound email.
APP_BASE_URL=http://localhost:3001
# 32+ char random secret used to HMAC-sign unsubscribe tokens. Rotating this invalidates
# every previously-sent unsubscribe link (recipients would need to unsubscribe again).
UNSUBSCRIBE_TOKEN_SECRET=change-me-to-a-long-random-string

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_NAME=replai

OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key

JWT_SECRET=change-me-to-a-long-random-string

AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_BUCKET_NAME=your-s3-bucket-name
AWS_REGION=us-east-1

# Domain/mailbox onboarding (SES + Route53)
SES_MAIL_FROM_SUBDOMAIN=mail
SES_DMARC_POLICY=v=DMARC1; p=none; rua=mailto:dmarc-reports@your-domain.com

# Google Calendar OAuth (meeting booking)
GOOGLE_CALENDAR_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3001/api/v1/calendar/google/callback
# 32+ char random secret used to derive the AES-256-GCM key for stored calendar tokens.
# Rotating this value makes every previously stored calendar token undecryptable.
CALENDAR_ENCRYPTION_KEY=change-me-to-a-long-random-string
